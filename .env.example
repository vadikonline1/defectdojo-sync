# ============================================================
# defectdojo-sync ALL-IN-ONE (openvas + wazuh, un singur container)
# Sablon — copiati in .env si completati cu valorile reale.
# Valorile de mai jos sunt fictive (domenii example.*).
# ============================================================

# ---------- DefectDojo (comun) ----------
DEFECTDOJO_URL=http://defectdojo.example.local:8080
DEFECTDOJO_API_TOKEN=7f3a9c1e4b264d8f0a5c7e3b91d6f2a4c8e0b1357d
DEFECTDOJO_VERIFY_TLS=false
DEFECTDOJO_PRODUCT_TYPE=Security Scanning

# ---------- Scheduler (comun) ----------
SYNC_INTERVAL=3600
LOG_LEVEL=INFO

# ============================================================
# openvas-* (Greenbone/OpenVAS)
# ============================================================
GVM_SOCKET=/run/gvmd/gvmd.sock
GVM_USERNAME=admin
GVM_PASSWORD=Tr7uB-well-K8s3c-peQe
OPENVAS_PRODUCT=Greenbone
OPENVAS_PRODUCT_TYPE=Security Scanning
OPENVAS_ENGAGEMENT=Greenbone Automated Scans
OPENVAS_SCAN_TYPE=OpenVAS Parser
OPENVAS_REPORT_DIR=/data/openvas-reports
OPENVAS_STATE_FILE=/data/state/openvas-state.txt
OPENVAS_ONLY_FINISHED=true

# ============================================================
# wazuh-* (Wazuh 4.14.x — API :55000 + OpenSearch :9200)
# ============================================================
WAZUH_BASE_URL=https://wazuh.example.local:55000
WAZUH_USERNAME=wazuh-api-user
WAZUH_PASSWORD=Fj8sL2-qP5xRt-91ZmQc-vB4hNw
WAZUH_VERIFY_TLS=false
WAZUH_GROUP=
WAZUH_AGENT_LIMIT=100000
OPENSEARCH_HOST=opensearch.example.local
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=opensearch-reader
OPENSEARCH_PASSWORD=Kx7dP0-mN3vBq-48TjHs-wQ9zLx
OPENSEARCH_VERIFY_TLS=false
OPENSEARCH_INDEX=wazuh-states-vulnerabilities-*
WAZUH_MIN_SEVERITY=
WAZUH_PRODUCT=Wazuh
WAZUH_PRODUCT_TYPE=Security Scanning
WAZUH_ENGAGEMENT=Wazuh Automated Scans
WAZUH_SCAN_TYPE=Wazuh
WAZUH_TEST_TITLE=Wazuh vulnerabilities
WAZUH_REPORT_DIR=/data/wazuh-reports
WAZUH_STATE_FILE=/data/state/wazuh-sync-state.json
MAX_FINDINGS_PER_IMPORT=15000
# true = inchide findings care lipsesc din import; tine false cand importul
# se face in chunkuri (altfel fiecare chunk inchide findings-urile celorlalte)
WAZUH_CLOSE_OLD_FINDINGS=false
